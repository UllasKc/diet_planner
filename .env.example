# Copy this file to .env and fill in real values. Never commit .env.

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database (Postgres connection string, e.g. from Supabase) ---
# Omit this to fall back to a local SQLite file for dev.
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- LLM (NVIDIA NIM, OpenAI-compatible) ---
LLM_API_KEY=nvapi-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_EXTRA_BODY={}

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
